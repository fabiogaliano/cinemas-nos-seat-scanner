# Copy to .env and fill in. The whole autobuy/ folder is gitignored, but never
# commit real values anywhere.

# --- Buyer details ("dados pessoais" step, and the MB WAY phone) ---
BUYER_NAME=
BUYER_PHONE=
BUYER_EMAIL=

# --- What to watch and buy ---
WATCH_AGGREGATE_ID=1e70190b-5cf3-4937-b361-24f67bdd11d0   # A Odisseia (IMAX + 2D)
WATCH_MOVIE_URL=https://www.cinemas.nos.pt/filmes/a-odisseia--imax--514040668.html
WATCH_CINEMA=Colombo
WATCH_FORMAT=imax
TICKET_COUNT=2

# Matched as prefixes, in order. "20:" catches any 20:xx showing; "20:10" is
# exact. There is no fallback beyond this list.
WATCH_PREFERRED_TIMES=20:

# hold — run everything, stop on the paygate page, send no MB WAY push
# buy  — press "Pagar agora", which pushes to the phone for approval
PURCHASE_MODE=hold

# Subscribe to this topic in the ntfy app to get the screenshots.
# Retention also posts its "Comprar agora" / "Parar" buttons here, and reads
# your taps from "<topic>-control". Do not subscribe to the -control topic:
# it exists so a tap does not notify you back.
NTFY_TOPIC=

# Stranger avoidance is off unless this is "1".
AVOID_STRANGERS=0

# --- Holding seats after an unapproved push ---
# 1 keeps re-taking the same seats every ~5 minutes instead of losing them when
# nobody taps the push at 3am. Buys nothing on its own: it waits for you to tap
# "Comprar agora" on the alert.
RETAIN_ON_FAILURE=0

# When retention gives up, HH:MM local.
RETAIN_UNTIL=09:00

# How long to watch the paygate before concluding the push went unapproved.
# A pending MB WAY payment holds the seats well past its own countdown, so
# there is no point acting sooner.
OBSERVE_PAYMENT_MS=480000
